<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid Dark Base -->
    <item>
        <color android:color="@color/cyber_dark" />
    </item>

    <!-- Deep Global Gradient -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#1A00E5FF"
                android:endColor="#0A000000"
                android:type="linear" />
        </shape>
    </item>

    <!-- Radar HUD Lines -->
    <item android:top="-300dp" android:left="-150dp" android:right="-150dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#0FFFFFFF" />
        </shape>
    </item>
    <item android:top="-200dp" android:left="-80dp" android:right="-80dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#0AFFFFFF" />
        </shape>
    </item>

    <!-- Field Perspective Lines (Vertical) -->
    <item android:left="50dp" android:right="50dp">
        <shape>
            <stroke android:width="0.5dp" android:color="#08FFFFFF" />
        </shape>
    </item>
    <item android:left="100dp" android:right="100dp">
        <shape>
            <stroke android:width="0.5dp" android:color="#08FFFFFF" />
        </shape>
    </item>
    <item android:left="150dp" android:right="150dp">
        <shape>
            <stroke android:width="0.5dp" android:color="#08FFFFFF" />
        </shape>
    </item>

    <!-- Bottom Field Glow -->
    <item android:top="500dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#2539FF14"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
