<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05080F">

    <!-- Background Image: Macro Grass -->
    <ImageView
        android:id="@+id/bgGrass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_grass_macro"
        android:contentDescription="Stadium Background" />

    <!-- Dark Overlay to improve readability -->
    <View
        android:id="@+id/bgOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000" />

    <!-- Matrix Background Effect -->
    <com.rgdbet.app.ui.NeuralMatrixView
        android:id="@+id/matrixView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.rgdbet.app.ui.StadiumFloodlightView
        android:id="@+id/floodlightView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="25dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/logoWrapper"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

                <LinearLayout
                    android:id="@+id/letterContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:clipChildren="false">
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:text="rGdbet"
                    android:textColor="#FFFFFF"
                    android:textSize="56sp"
                    android:fontFamily="sans-serif-black"
                    android:visibility="invisible" />

                <!-- Juggling Ball -->
                <TextView
                    android:id="@+id/jugglingBall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚽"
                    android:textSize="32sp"
                    android:elevation="25dp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:includeFontPadding="false"
                    android:visibility="invisible" />
            </FrameLayout>

            <View
                android:id="@+id/titleUnderline"
                android:layout_width="120dp"
                android:layout_height="4dp"
                android:background="@color/neon_green"
                app:layout_constraintTop_toBottomOf="@+id/logoWrapper"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/glassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:cardBackgroundColor="#0DFFFFFF"
                app:cardCornerRadius="24dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#3039FF14"
                app:layout_constraintTop_toBottomOf="@+id/titleUnderline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:hint="JUCĂTOR"
                        app:hintTextColor="@color/neon_green"
                        app:boxStrokeColor="@color/neon_green"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="#2039FF14"
                        app:boxCornerRadiusTopStart="30dp"
                        app:boxCornerRadiusTopEnd="30dp"
                        app:boxCornerRadiusBottomStart="30dp"
                        app:boxCornerRadiusBottomEnd="30dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:fontFamily="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:hint="EMAIL"
                        app:hintTextColor="@color/neon_green"
                        app:boxStrokeColor="@color/neon_green"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="#2039FF14"
                        app:boxCornerRadiusTopStart="30dp"
                        app:boxCornerRadiusTopEnd="30dp"
                        app:boxCornerRadiusBottomStart="30dp"
                        app:boxCornerRadiusBottomEnd="30dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:fontFamily="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:hint="PAROLĂ"
                        app:hintTextColor="@color/neon_green"
                        app:boxStrokeColor="@color/neon_green"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="#2039FF14"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/neon_green"
                        app:boxCornerRadiusTopStart="30dp"
                        app:boxCornerRadiusTopEnd="30dp"
                        app:boxCornerRadiusBottomStart="30dp"
                        app:boxCornerRadiusBottomEnd="30dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:inputType="textPassword"
                            android:fontFamily="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:hint="CONFIRMĂ PAROLA"
                        app:hintTextColor="@color/neon_green"
                        app:boxStrokeColor="@color/neon_green"
                        app:boxStrokeWidth="2dp"
                        app:boxBackgroundColor="#2039FF14"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/neon_green"
                        app:boxCornerRadiusTopStart="30dp"
                        app:boxCornerRadiusTopEnd="30dp"
                        app:boxCornerRadiusBottomStart="30dp"
                        app:boxCornerRadiusBottomEnd="30dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:inputType="textPassword"
                            android:fontFamily="monospace" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <CheckBox
                        android:id="@+id/cbTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Sunt de acord cu protocoalele echipei"
                        android:textColor="#80FFFFFF"
                        android:textSize="10sp"
                        android:buttonTint="@color/neon_green" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:text="INTRA PE TEREN"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:letterSpacing="0.05"
                        android:background="@drawable/stadium_button_bg"
                        android:textAllCaps="true"
                        android:elevation="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvGoLogin"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:text="ÎNAPOI LA AUTENTIFICARE"
                android:textColor="@color/neon_blue"
                android:fontFamily="monospace"
                android:textSize="16sp"
                android:textStyle="bold"
                app:strokeColor="@color/neon_blue"
                app:strokeWidth="2dp"
                app:cornerRadius="4dp"
                app:rippleColor="#4000E5FF"
                app:layout_constraintTop_toBottomOf="@+id/glassCard"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                android:indeterminateTint="@color/neon_green"
                app:layout_constraintTop_toBottomOf="@+id/tvGoLogin"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/rgb_danger"
                android:gravity="center"
                android:fontFamily="monospace"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/progressBar" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
