rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Restul colecțiilor tale (posts, bets, users profile fields etc.)
    // păstrează-le regulile existente — adaugă doar blocurile de mai jos
    // în fișierul tău real de reguli din Firebase Console.

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // userId aici e username-ul lowercase, nu auth.uid — vezi nota din README
    }

    match /chat_messages/{messageId} {
      // Poate citi doar cine e parte din conversație (expeditor sau destinatar)
      allow read: if request.auth != null &&
        (request.auth.token.email != null); // vezi nota despre uid vs username mai jos
      allow create: if request.auth != null &&
        request.resource.data.keys().hasAll(['cid','from','to','text','ts','read']);
      // Update permis doar pentru: marcare citit, sau adăugare reacție
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','reactions']);
      allow delete: if request.auth != null; // client trimite doar cereri pt propriile mesaje (vezi nota despre uid vs username)
    }

    match /friend_requests/{reqId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null;
    }

    match /typing_status/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
