rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imagini de chat: doar userii autentificați pot urca/citi
    match /chat_images/{cid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024   // max 8MB per imagine
                   && request.resource.contentType.matches('image/.*');
    }

    // ⚠️ Restul path-urilor tale existente (avatare etc.) — adaugă regulile
    // lor aici, nu le suprascrie doar pe cele de mai sus.
  }
}
